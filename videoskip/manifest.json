{
  "manifest_version": 3,
  "name": "VideoSeek",
  "version": "0.1.0",
  "description": "用 Shift + 左右方向键按自定义步长快进/快退，按 Shift + G 输入时间点直接跳转。",
  "permissions": ["storage"],
  "action": {
    "default_title": "VideoSeek",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["time.js", "content.js"],
      "all_frames": true
    }
  ]
}
