{
  "name": "disksniffer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fast disk space analyzer with treemap visualization",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icon": "node scripts/gen-icon.mjs",
    "check:treemap": "node --experimental-strip-types --no-warnings scripts/check-treemap.ts",
    "check:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
